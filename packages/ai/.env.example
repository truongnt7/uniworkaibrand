# Sao chép thành .env (đã được .gitignore chặn) hoặc đặt trong biến môi trường của tiến trình.
# KHÔNG commit khoá thật. Trong bản phát hành, khoá nhà cung cấp chỉ nằm ở AI Gateway (server);
# app chỉ giữ token workspace do Gateway cấp.

# --- LLM (Đạo diễn AI, caption): endpoint OpenAI-compatible (AI Gateway của ta, hoặc nhà cung cấp khi dev) ---
APS_AI_BASE_URL=
APS_AI_API_KEY=
APS_AI_MODEL=
# Model riêng theo tác vụ (tuỳ chọn)
APS_AI_MODEL_DIRECTOR=
APS_AI_MODEL_CAPTION=
APS_AI_TIMEOUT_MS=20000
# auto: dùng LLM nếu đã cấu hình, lỗi thì tự về rule-based. rules: luôn offline.
APS_AI_MODE=auto

# --- Tách nền local (ONNX, chạy CPU) ---
# Đường dẫn file model (tải bằng `pnpm --filter @aps/ai bg:download`). Mặc định: packages/ai/models/u2netp.onnx
APS_BG_MODEL_PATH=

# --- Image→3D (P0-11): CHỈ đặt ở máy chủ AI Gateway, KHÔNG đưa vào app desktop ---
# TRIPO_API_KEY=
# MESHY_API_KEY=
# HUNYUAN3D_SECRET_ID=
# HUNYUAN3D_SECRET_KEY=
# RODIN_API_KEY=
