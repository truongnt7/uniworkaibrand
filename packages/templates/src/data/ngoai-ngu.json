{
  "industry": "ngoai-ngu",
  "templates": [
    {
      "id": "nn-khai-giang",
      "industry": "ngoai-ngu",
      "name": "Thông báo khai giảng",
      "summary": "Khoá học mới: tên khoá, lịch học, học phí, địa chỉ. Ảnh không bắt buộc.",
      "goal": "tuyen-sinh",
      "evidence": "assumption",
      "aspects": [
        "9:16",
        "4:5",
        "1:1"
      ],
      "defaultAspect": "9:16",
      "channels": [
        "facebook",
        "zalo",
        "tiktok"
      ],
      "palette": {
        "primary": "#1c7ed6",
        "accent": "#fcc419"
      },
      "fields": [
        {
          "key": "businessName",
          "label": "Tên cơ sở / thương hiệu",
          "example": "Cửa hàng Mẫu",
          "required": true
        },
        {
          "key": "phone",
          "label": "Số điện thoại liên hệ",
          "example": "0901 234 567",
          "required": true,
          "hint": "Số khách gọi hoặc nhắn Zalo cho bạn."
        },
        {
          "key": "itemName",
          "label": "Tên khoá học",
          "example": "Tiếng Anh giao tiếp",
          "required": true
        },
        {
          "key": "detail",
          "label": "Lịch học / ngày khai giảng",
          "example": "Khai giảng 05/12, học tối 2-4-6",
          "required": true
        },
        {
          "key": "price",
          "label": "Học phí (không bắt buộc)",
          "example": "1.500.000đ/tháng",
          "required": false,
          "hint": "Ghi rõ đơn vị (tháng, khoá)."
        },
        {
          "key": "promo",
          "label": "Ưu đãi (nếu có)",
          "example": "Đăng ký sớm trước 01/12",
          "required": false
        },
        {
          "key": "address",
          "label": "Địa chỉ trung tâm",
          "example": "10 Đường Nguyễn Trãi, Phường 2",
          "required": true
        }
      ],
      "photos": [
        {
          "id": "anh1",
          "label": "Ảnh lớp học / trung tâm (không bắt buộc)",
          "required": false,
          "hint": "Không đăng ảnh học viên nhỏ tuổi nếu chưa được phụ huynh đồng ý."
        }
      ],
      "scenes": [
        {
          "type": "card",
          "durationS": 3.5,
          "texts": [
            {
              "text": "{{itemName}}",
              "position": "center",
              "style": "title"
            },
            {
              "text": "{{detail}}",
              "position": "lower_third",
              "style": "body",
              "color": "accent"
            }
          ],
          "background": "primary"
        },
        {
          "type": "photo",
          "slot": "anh1",
          "durationS": 3.5,
          "texts": [
            {
              "text": "{{price}}",
              "position": "lower_third",
              "style": "title",
              "color": "accent"
            },
            {
              "text": "{{promo}}",
              "position": "bottom",
              "style": "body"
            }
          ],
          "shade": 0.3
        },
        {
          "type": "card",
          "durationS": 4.0,
          "texts": [
            {
              "text": "{{businessName}}",
              "position": "center",
              "style": "title"
            },
            {
              "text": "Liên hệ: {{phone}}",
              "position": "lower_third",
              "style": "body",
              "color": "accent"
            },
            {
              "text": "{{address}}",
              "position": "bottom",
              "style": "small"
            }
          ],
          "background": "primary"
        }
      ],
      "logo": "end_card",
      "music": "optional",
      "caption": {
        "lines": [
          "Khai giảng: {{itemName}}",
          "{{detail}}",
          "Học phí: {{price}}",
          "{{promo}}",
          "Địa chỉ: {{address}}",
          "Đăng ký tư vấn: {{phone}}"
        ],
        "hashtags": [
          "#hoctienganh",
          "#khaigiang"
        ]
      }
    },
