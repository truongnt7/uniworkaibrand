{
  "industry": "nha-hang",
  "templates": [
    {
      "id": "nh-mon-moi",
      "industry": "nha-hang",
      "name": "Giới thiệu món ăn",
      "summary": "Giới thiệu một món với 1–3 ảnh, tên món, giá, địa chỉ quán.",
      "goal": "gioi-thieu",
      "evidence": "assumption",
      "aspects": [
        "9:16",
        "4:5",
        "1:1"
      ],
      "defaultAspect": "9:16",
      "channels": [
        "facebook",
        "zalo",
        "tiktok"
      ],
      "palette": {
        "primary": "#8a1c1c",
        "accent": "#f5c542"
      },
      "fields": [
        {
          "key": "businessName",
          "label": "Tên cơ sở / thương hiệu",
          "example": "Cửa hàng Mẫu",
          "required": true
        },
        {
          "key": "phone",
          "label": "Số điện thoại liên hệ",
          "example": "0901 234 567",
          "required": true,
          "hint": "Số khách gọi hoặc nhắn Zalo cho bạn."
        },
        {
          "key": "itemName",
          "label": "Tên món",
          "example": "Bún bò đặc biệt",
          "required": true
        },
        {
          "key": "price",
          "label": "Giá",
          "example": "55.000đ",
          "required": false
        },
        {
          "key": "address",
          "label": "Địa chỉ quán",
          "example": "25 Đường Trần Phú, Phường 3",
          "required": true,
          "hint": "Khách cần địa chỉ để tìm tới quán."
        },
        {
          "key": "detail",
          "label": "Giờ mở cửa (nếu có)",
          "example": "6:00 - 21:00",
          "required": false
        }
      ],
      "photos": [
        {
          "id": "anh1",
          "label": "Ảnh món ăn",
          "required": true,
          "hint": "Chụp gần, ánh sáng tự nhiên, thấy rõ món."
        },
        {
          "id": "anh2",
          "label": "Ảnh góc khác (không bắt buộc)",
          "required": false
        },
        {
          "id": "anh3",
          "label": "Ảnh khác (không bắt buộc)",
          "required": false
        }
      ],
      "scenes": [
        {
          "type": "photo",
          "slot": "anh1",
          "durationS": 3.5,
          "texts": [
            {
              "text": "{{itemName}}",
              "position": "lower_third",
              "style": "title"
            },
            {
              "text": "{{price}}",
              "position": "bottom",
              "style": "title",
              "color": "accent"
            }
          ]
        },
        {
          "type": "photo",
          "slot": "anh2",
          "durationS": 3.0,
          "texts": [
            {
              "text": "{{itemName}}",
              "position": "lower_third",
              "style": "body"
            }
          ]
        },
        {
          "type": "photo",
          "slot": "anh3",
          "durationS": 3.0,
          "texts": []
        },
        {
          "type": "card",
          "durationS": 4.0,
          "texts": [
            {
              "text": "{{businessName}}",
              "position": "center",
              "style": "title"
            },
            {
              "text": "Liên hệ: {{phone}}",
              "position": "lower_third",
              "style": "body",
              "color": "accent"
            },
            {
              "text": "{{address}}",
              "position": "bottom",
              "style": "small"
            }
          ],
          "background": "primary"
        }
      ],
      "logo": "end_card",
      "music": "optional",
      "caption": {
        "lines": [
          "{{itemName}}",
          "Giá: {{price}}",
          "Giờ mở cửa: {{detail}}",
          "Địa chỉ: {{address}}",
          "Liên hệ: {{phone}}"
        ],
        "hashtags": [
          "#monngon"
        ]
      }
