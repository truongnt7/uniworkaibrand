        {
          "key": "detail",
          "label": "Địa điểm (không bắt buộc)",
          "example": "Tỉnh Đồng Nai",
          "required": false
        },
        {
          "key": "address",
          "label": "Địa chỉ (nếu có cửa hàng/văn phòng)",
          "example": "12 Đường Số 1, Phường A, Quận B",
          "required": false,
          "hint": "Ghi đủ để khách tìm đến. Bỏ trống nếu chỉ bán qua mạng."
        }
      ],
      "photos": [
        {
          "id": "truoc",
          "label": "Ảnh TRƯỚC khi cải tạo",
          "required": true,
          "hint": "Chụp cùng góc với ảnh sau."
        },
        {
          "id": "sau",
          "label": "Ảnh SAU khi cải tạo",
          "required": true
        }
      ],
      "scenes": [
        {
          "type": "photo",
          "slot": "truoc",
          "durationS": 3.0,
          "texts": [
            {
              "text": "TRƯỚC",
              "position": "top",
              "style": "title"
            }
          ]
        },
        {
          "type": "photo",
          "slot": "sau",
          "durationS": 3.5,
          "texts": [
            {
              "text": "SAU",
              "position": "top",
              "style": "title",
              "color": "accent"
            }
          ],
          "transition": "wipeleft"
        },
        {
          "type": "collage",
          "slots": [
            "truoc",
            "sau"
          ],
          "durationS": 4.0,
          "texts": [
            {
              "text": "{{itemName}}",
              "position": "bottom",
              "style": "body"
            }
          ]
        },
        {
          "type": "card",
          "durationS": 4.0,
          "texts": [
            {
              "text": "{{businessName}}",
              "position": "center",
              "style": "title"
            },
            {
              "text": "Liên hệ: {{phone}}",
              "position": "lower_third",
              "style": "body",
              "color": "accent"
            },
            {
              "text": "{{address}}",
              "position": "bottom",
              "style": "small"
            }
          ],
          "background": "primary"
        }
      ],
      "logo": "end_card",
      "music": "optional",
      "caption": {
        "lines": [
          "{{itemName}}: trước và sau",
          "Địa điểm: {{detail}}",
          "Liên hệ: {{phone}}",
          "Địa chỉ: {{address}}"
        ],
        "hashtags": [
          "#truocvasau",
          "#xaydung"
        ]
      }
