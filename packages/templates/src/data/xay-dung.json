{
  "industry": "xay-dung",
  "templates": [
    {
      "id": "xd-tien-do",
      "industry": "xay-dung",
      "name": "Tiến độ công trình",
      "summary": "Kể công trình qua các giai đoạn, mỗi ảnh một dòng chú thích do bạn tự nhập.",
      "goal": "tien-do",
      "evidence": "assumption",
      "aspects": [
        "9:16",
        "4:5",
        "1:1"
      ],
      "defaultAspect": "9:16",
      "channels": [
        "facebook",
        "zalo",
        "tiktok"
      ],
      "palette": {
        "primary": "#2b2f36",
        "accent": "#f59f00"
      },
      "fields": [
        {
          "key": "businessName",
          "label": "Tên cơ sở / thương hiệu",
          "example": "Cửa hàng Mẫu",
          "required": true
        },
        {
          "key": "phone",
          "label": "Số điện thoại liên hệ",
          "example": "0901 234 567",
          "required": true,
          "hint": "Số khách gọi hoặc nhắn Zalo cho bạn."
        },
        {
          "key": "itemName",
          "label": "Tên công trình",
          "example": "Nhà phố 1 trệt 2 lầu",
          "required": true
        },
        {
          "key": "detail",
          "label": "Địa điểm (không bắt buộc)",
          "example": "Tỉnh Đồng Nai",
          "required": false,
          "hint": "Chỉ ghi khu vực nếu chủ nhà đồng ý."
        }
      ],
      "photos": [
        {
          "id": "g1",
          "label": "Ảnh giai đoạn 1",
          "required": true,
          "caption": {
            "label": "Chú thích giai đoạn",
            "example": "Đổ móng",
            "maxChars": 50
          }
        },
        {
          "id": "g2",
          "label": "Ảnh giai đoạn 2",
          "required": true,
          "caption": {
            "label": "Chú thích giai đoạn",
            "example": "Xây phần thô",
            "maxChars": 50
          }
        },
        {
          "id": "g3",
          "label": "Ảnh giai đoạn 3 (không bắt buộc)",
          "required": false,
          "caption": {
            "label": "Chú thích giai đoạn",
            "example": "Hoàn thiện",
            "maxChars": 50
          }
        }
      ],
      "scenes": [
        {
          "type": "photo",
          "slot": "g1",
          "durationS": 3.5,
          "texts": [
            {
              "text": "{{itemName}}",
              "position": "top",
              "style": "body"
            },
            {
              "text": "{{caption:g1}}",
              "position": "lower_third",
              "style": "title"
            }
          ]
        },
        {
          "type": "photo",
          "slot": "g2",
          "durationS": 3.5,
          "texts": [
            {
              "text": "{{itemName}}",
              "position": "top",
              "style": "body"
            },
            {
              "text": "{{caption:g2}}",
              "position": "lower_third",
              "style": "title"
            }
          ]
        },
        {
          "type": "photo",
          "slot": "g3",
          "durationS": 3.5,
          "texts": [
            {
              "text": "{{itemName}}",
              "position": "top",
              "style": "body"
            },
            {
              "text": "{{caption:g3}}",
              "position": "lower_third",
              "style": "title"
            }
          ]
        },
        {
          "type": "card",
          "durationS": 4.0,
          "texts": [
            {
              "text": "{{businessName}}",
              "position": "center",
              "style": "title"
            },
            {
              "text": "Liên hệ: {{phone}}",
              "position": "lower_third",
              "style": "body",
              "color": "accent"
            },
            {
              "text": "{{detail}}",
              "position": "bottom",
              "style": "small"
            }
          ],
          "background": "primary"
        }
      ],
      "logo": "end_card",
      "music": "optional",
      "caption": {
        "lines": [
          "{{itemName}}",
          "{{caption:g1}}",
          "{{caption:g2}}",
          "{{caption:g3}}",
          "Địa điểm: {{detail}}",
          "Liên hệ: {{phone}}"
        ],
        "hashtags": [
          "#xaydung"
        ]
      }
    },
    {
      "id": "xd-truoc-sau",
      "industry": "xay-dung",
      "name": "Cải tạo trước và sau",
      "summary": "So sánh trước và sau khi cải tạo, sửa chữa.",
      "goal": "truoc-sau",
      "evidence": "assumption",
      "aspects": [
        "9:16",
        "1:1",
        "4:5",
        "16:9"
      ],
      "defaultAspect": "9:16",
      "channels": [
        "facebook",
        "zalo",
        "tiktok"
      ],
      "palette": {
        "primary": "#2b2f36",
        "accent": "#f59f00"
      },
      "fields": [
        {
          "key": "businessName",
          "label": "Tên cơ sở / thương hiệu",
          "example": "Cửa hàng Mẫu",
          "required": true
        },
        {
          "key": "phone",
          "label": "Số điện thoại liên hệ",
          "example": "0901 234 567",
          "required": true,
          "hint": "Số khách gọi hoặc nhắn Zalo cho bạn."
        },
        {
          "key": "itemName",
          "label": "Hạng mục cải tạo",
          "example": "Cải tạo phòng bếp",
          "required": true
