        {
          "id": "anh2",
          "label": "Ảnh sản phẩm 2 (không bắt buộc)",
          "required": false
        }
      ],
      "scenes": [
        {
          "type": "photo",
          "slot": "anh1",
          "durationS": 3.5,
          "texts": [
            {
              "text": "{{promo}}",
              "position": "center",
              "style": "title",
              "color": "accent"
            }
          ],
          "shade": 0.35,
          "motion": "zoom_in"
        },
        {
          "type": "photo",
          "slot": "anh2",
          "durationS": 3.0,
          "texts": [
            {
              "text": "{{itemName}}",
              "position": "lower_third",
              "style": "title"
            },
            {
              "text": "{{detail}}",
              "position": "bottom",
              "style": "body"
            }
          ],
          "shade": 0.2
        },
        {
          "type": "card",
          "durationS": 4.0,
          "texts": [
            {
              "text": "{{businessName}}",
              "position": "center",
              "style": "title"
            },
            {
              "text": "Liên hệ: {{phone}}",
              "position": "lower_third",
              "style": "body",
              "color": "accent"
            },
            {
              "text": "{{address}}",
              "position": "bottom",
              "style": "small"
            }
          ],
          "background": "primary"
        }
      ],
      "logo": "end_card",
      "music": "optional",
      "caption": {
        "lines": [
          "{{promo}}",
          "{{itemName}}",
          "Thời gian: {{detail}}",
          "Liên hệ: {{phone}}",
          "Địa chỉ: {{address}}"
        ],
        "hashtags": [
          "#khuyenmai"
        ]
      }
    },
