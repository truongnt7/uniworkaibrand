{
  "name": "ai-product-studio",
  "private": true,
  "version": "0.0.0",
  "description": "AI Product Studio - monorepo (Phase 0 PoC: Electron + Blender 4.5 LTS headless)",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "poc:render": "pnpm --filter @aps/desktop poc:cli",
    "dev": "pnpm --filter @aps/desktop dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
