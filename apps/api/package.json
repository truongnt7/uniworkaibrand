{
  "name": "@aps/api",
  "version": "0.0.0",
  "private": true,
  "description": "AI Product Studio - backend API (NestJS + PostgreSQL + S3-compatible)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "migrate": "tsx src/cli/migrate.ts run",
    "migrate:revert": "tsx src/cli/migrate.ts revert",
    "migrate:status": "tsx src/cli/migrate.ts status",
    "keys:dev": "tsx src/cli/gen-dev-key.ts",
    "admin:create": "tsx src/cli/create-platform-admin.ts",
    "openapi:export": "tsc -p tsconfig.build.json && node dist/cli/export-openapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@node-rs/argon2": "^2.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "~0.3.27",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@aps/shared": "workspace:*",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.13.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.9.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
