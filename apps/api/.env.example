# Sao chép thành apps/api/.env (đã gitignore). KHÔNG commit giá trị thật.
APS_ENV=development
PORT=3000
DEFAULT_LOCALE=vi
CORS_ORIGINS=
RATE_LIMIT_ENABLED=true

DATABASE_URL=postgres://aps:aps@localhost:5432/aps
DB_MIGRATIONS_RUN=true

S3_ENDPOINT=http://localhost:9000
# Host mà client (Electron) nhìn thấy để PUT/GET presigned URL; mặc định = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aps-dev
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

JWT_ACCESS_SECRET=change-me-dev-only-0123456789abcdef0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000

# Khóa ký manifest runtime (ed25519, PKCS8 PEM; xuống dòng viết \n hoặc dùng base64 của PEM).
# DEV: chạy `pnpm --filter @aps/api keys:dev` để sinh và ghi vào .env (key id dev-*).
# PRODUCTION: key id prod-*, private key chỉ nằm trong secret manager của hạ tầng, không bao giờ trong repo.
MANIFEST_SIGNING_KEY=
MANIFEST_KEY_ID=
